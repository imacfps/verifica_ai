# URL base da API a partir do browser. Em dev, deixe vazio para usar o
# proxy do Vite (/api/v1 -> VITE_API_PROXY_TARGET). Em produção, aponte
# diretamente para a API pública, ex.: https://api.verifica.ai/v1
VITE_API_URL=/api/v1

# Alvo do proxy de desenvolvimento do Vite (não usado em build de produção)
VITE_API_PROXY_TARGET=http://localhost:8000
