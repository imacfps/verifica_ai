# Copie para .env e ajuste. Nunca commitar o .env real.

ENVIRONMENT=development
DEBUG=true

# CSV de origens autorizadas — nunca usar "*" em produção
CORS_ORIGINS=http://localhost:5173
ALLOWED_EXTENSION_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1

RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_DEFAULT=60/minute
# Por cliente (API key), não por IP — ver docs/public_api.md
RATE_LIMIT_PUBLIC_API=30/minute

MAX_UPLOAD_MB=10

# auto | mock | hf | gemini | ensemble | frequency | llm_judge
# - auto: gemini (checkpoint próprio, se existir) -> ensemble -> mock
# - ensemble: combina frequency + hf + llm_judge (o que estiver disponível)
# - gemini: modelo próprio — ver backend/training/README.md
DETECTOR_MODE=mock
HF_MODEL_ID=umm-maybe/AI-image-detector
GEMINI_MODEL_PATH=models/gemini_detector.pt

# LlmJudgeDetector (sinal do ensemble via API do Gemini — opcional, sem
# isso o ensemble roda só com frequency + hf)
GEMINI_API_KEY=
GEMINI_LLM_JUDGE_MODEL=gemini-2.5-flash

DATABASE_URL=postgresql+asyncpg://verifica:verifica@localhost:5432/verifica_ai
ENABLE_ANALYSIS_LOGGING=false

LOG_LEVEL=INFO
LOG_JSON=true
