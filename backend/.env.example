# Copie para .env e ajuste. Nunca commitar o .env real.

ENVIRONMENT=development
DEBUG=true

# CSV de origens autorizadas — nunca usar "*" em produção
CORS_ORIGINS=http://localhost:5173
ALLOWED_EXTENSION_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1

RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_DEFAULT=60/minute

MAX_UPLOAD_MB=10

# auto | mock | hf | gemini — ver backend/training/README.md para o modo "gemini"
DETECTOR_MODE=mock
HF_MODEL_ID=umm-maybe/AI-image-detector
GEMINI_MODEL_PATH=models/gemini_detector.pt

DATABASE_URL=postgresql+asyncpg://verifica:verifica@localhost:5432/verifica_ai
ENABLE_ANALYSIS_LOGGING=false

LOG_LEVEL=INFO
LOG_JSON=true
